# ===== Project Data — Regenerable & Ephemeral =====
# ChromaDB's persisted vector index — large binary files, fully rebuildable
# by running scripts/setup.py or rag_pipeline/retrieve.py against data/pdfs/.
data/chroma/*

# Live-uploaded PDFs (Phase 4 feature) — ephemeral runtime additions.
# Keeps repo clean while preserving directory structure via .gitkeep.
data/pdfs/uploads/*
!data/pdfs/uploads/.gitkeep

# Live-uploaded databases (built from user .sql scripts) — ephemeral runtime additions.
data/db/uploads/*

# ===== Project Data — Kept in git =====
# data/db/chinook.db       # Reference SQLite demo database
# data/db/Chinook_Sqlite.sql
# data/pdfs/*.pdf          # Baseline knowledge documents
# data/samples/*.sql       # Demo SQL upload scripts

